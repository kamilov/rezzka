{
  "name": "rezzka",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "npm@10.9.9",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-service.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:release": "node --test tests/release/*.test.mjs",
    "screenshots": "playwright test -c tests/screenshots/playwright.config.ts",
    "check": "npm run typecheck && npm test && npm run test:release && npm run build && npm run test:e2e",
    "package:tv": "npm run build && node scripts/package-tv.mjs",
    "tv": "node scripts/tv.mjs"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "3.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webos-tools/cli": "3.2.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
